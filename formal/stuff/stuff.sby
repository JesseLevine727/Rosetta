# SymbiYosys job for rosetta_stuff (spec v2).  Run from formal/stuff/:
#     sby -f stuff.sby            (all tasks)
#     sby -f stuff.sby prove      (one task: prove | bmc | cover)
#
# ---- Design under verification: exactly ONE of the two lines below ----
# The real design (default):
[files]
rosetta_stuff.sv ../../src/rosetta_stuff.sv
# The property writer's private reference model (NOT the design):
#rosetta_stuff.sv ref/rosetta_stuff.sv
stuff_props.sv
stuff_fv.sv

[tasks]
prove
bmc
cover

[options]
prove: mode prove
# BMC depth 24 -- supplementary only; the unbounded result is `prove`.
# Depth argument (spec v2): in the stand-alone part every reachable state
# of the spec model (run 0-7, last, viol) is reached within 9 cycles of
# reset (1 reset + 7 equal bits + 1 violating bit). The round-trip part adds
# a 2-entry wire, a per-frame cfg and the clear handshake, so B lags A by at
# most 2 bits plus one cycle. The deepest cover is the full N = 7 run after a
# violation (reset + 7 bits + violating bit + 6 bits + 1): step 16. Depth 24
# is that plus a margin of a further N = 7 run; cover depth is the same.
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 24

[engines]
prove: abc pdr
bmc: smtbmc bitwuzla
cover: smtbmc yices

[script]
read -formal rosetta_stuff.sv
read -formal stuff_props.sv
read -formal stuff_fv.sv
prep -top stuff_fv
