# SymbiYosys job for rosetta_xbar (xbar.md + decisions.md ruling 14).
# Run from formal/xbar/, with run directories kept out of the tree:
#     sby -f xbar.sby -d ref/build/xbar_prove prove   (one task: prove | bmc | cover)
#     sby --prefix ref/build/xbar -f xbar.sby         (all tasks)
#
# ---- Design under verification: exactly ONE of the two lines below ----
# The real design (default):
[files]
rosetta_xbar.sv ../../src/rosetta_xbar.sv
# The property writer's private reference model (NOT the design):
#rosetta_xbar.sv ref/rosetta_xbar.sv
xbar_props.sv
xbar_fv.sv

[tasks]
prove
bmc
cover

[options]
prove: mode prove
# BMC depth 14 -- supplementary only; the unbounded result is `prove`.
# Depth argument: the spec state is s1, s2, lin (pipeline, 48 bits) and the
# six configuration registers. From reset (step 0) every configuration is
# reached after at most six writes (one register per cycle, steps 1-6), and
# s1/s2/lin hold arbitrary pin data after three more cycles, which can
# overlap the writes: every reachable spec state is reached by step 7, and
# a reset in mid-trace only returns to the reset state. The longest window
# of any property is four cycles (a_p1_lane_in: pins three cycles back, the
# rst_n chain four cycles), and the checker model has the same reachable
# states as the spec. 7 + 4 = 11, plus a margin of 3: depth 14. The deepest
# covers (loopback: XCTL, XIN and XOUT writes in steps 1-3, the output in
# step 4, the lane input in step 5) are reached at step 5 on the reference
# model; cover depth 12 leaves room for a design that needs longer.
bmc: mode bmc
bmc: depth 14
cover: mode cover
cover: depth 12

[engines]
prove: abc pdr
bmc: smtbmc bitwuzla
cover: smtbmc yices

[script]
read -formal rosetta_xbar.sv
read -formal xbar_props.sv
read -formal xbar_fv.sv
prep -top xbar_fv
