# ============================================================================
#  Follow-up job (report finding 7): does a stale delayed change land after
#  a PIN? Separate from lane.sby, whose seven tasks are unchanged. Run from
#  formal/lane/:
#      sby -f -d ref/build/haz_bmc   lane_haz.sby haz_bmc
#      sby -f -d ref/build/haz_prove lane_haz.sby haz_prove
#
#  Properties: lane_props.sv, block "hazard" (define LANE_HAZARD), names h_*.
#  Every other assertion of the checker is removed here (chformal -remove);
#  the environment (u_*) is the same as in lane.sby.
#
#  haz_bmc    smtbmc bitwuzla, depth 24: all h_* (out3 included). Expected to
#             FAIL with the shortest trace (the out3 case of finding 7).
#             Depth 24: the coincidence cover c_haz_pin_dlyclk is reached at
#             step 8 in lane.sby cover; the stale change then lands within
#             the launch delay D <= 255 after it, and bmc finds the shortest
#             D. It is a search for a counterexample, not a claim.
#  haz_keep3  smtbmc bitwuzla, depth 24: h_keep3 alone (the observable
#             form), for the shortest trace in which the stale change lands.
#  haz_prove  abc pdr, unbounded: h_* without the out3 statements
#             (LANE_HAZ_NO_OUT3): PIN on out0..out2 against a pending
#             delayed DATA change, and abort / halt / SETM TICK against any
#             pending change.
# ============================================================================
[files]
rosetta_lane.sv ../../src/rosetta_lane.sv
#rosetta_lane.sv ref/rosetta_lane.sv
rosetta_cfg.sv ../../src/rosetta_cfg.sv
rosetta_tick.sv ../../src/rosetta_tick.sv
rosetta_delay.sv ../../src/rosetta_delay.sv
rosetta_coding.sv ../../src/rosetta_coding.sv
rosetta_field.sv ../../src/rosetta_field.sv
rosetta_crc.sv ../../src/rosetta_crc.sv
rosetta_stuff.sv ../../src/rosetta_stuff.sv
rosetta_events.sv ../../src/rosetta_events.sv
rosetta_pins.sv ../../src/rosetta_pins.sv
lane_wb.svh
lane_wb_dut.ys
lane_model.sv
lane_props.sv
lane_fv.sv

[tasks]
haz_bmc
haz_keep3
haz_prove

[options]
haz_bmc: mode bmc
haz_bmc: depth 24
haz_keep3: mode bmc
haz_keep3: depth 24
haz_prove: mode prove

[engines]
haz_bmc: smtbmc bitwuzla
haz_keep3: smtbmc bitwuzla
haz_prove: abc pdr

[script]
read -define LANE_HAZARD
haz_prove: read -define LANE_HAZ_NO_OUT3
read -formal rosetta_cfg.sv
read -formal rosetta_tick.sv
read -formal rosetta_delay.sv
read -formal rosetta_coding.sv
read -formal rosetta_field.sv
read -formal rosetta_crc.sv
read -formal rosetta_stuff.sv
read -formal rosetta_events.sv
read -formal rosetta_pins.sv
read -formal rosetta_lane.sv
read -formal lane_model.sv
read -formal lane_props.sv
read -formal lane_fv.sv
prep -top lane_fv
flatten
cd lane_fv
script lane_wb_dut.ys
cd ..
haz_bmc: chformal -assert -remove lane_fv/t:$check lane_fv/c:u_chk.h_* %d
haz_prove: chformal -assert -remove lane_fv/t:$check lane_fv/c:u_chk.h_* %d
haz_keep3: chformal -assert -remove lane_fv/t:$check lane_fv/c:u_chk.h_keep3 %d
