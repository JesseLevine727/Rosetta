# ============================================================================
#  SymbiYosys job BRINGUP for the chip top: the complete bring-up of top.md 6
#  as one cover trace on the COMPLETE chip (all four real lanes, every real
#  component, full behavioural SRAM models of mem.md 4.1):
#    reset -> SPI frame MDATA (program word 0) -> SPI frame XOUT0 (uo[2] <-
#    lane 0 out0) -> SPI frame CTRL[0] = 1 -> lane 0 executes word 0 -> uo[2]
#    driven by lane 0 within 8 cycles of the start.
#  The SPI pins are driven by a scripted master (top_spi_script, assumption
#  env_spi_script; frames at the fastest rate the host decodes, one rising
#  edge every 2 cycles), the program word is chosen by the solver (anyconst).
#  All checker assertions of top_chip_props are also active.
#  STATUS (clean reference): task cover TIMEOUT at the 30-minute cap
#  (c_s_pm_write and c_s_xout reached at step 280: SPI frames 1-2 served;
#  c_s_run0 / c_s_bringup not reached in time). Task core PASS.
#  Task core: the same bring-up at CORE level (u_host a shell, its request
#  interface free under the slot rule; real lanes, full SRAM models),
#  depth 40: reset 2, program write at the first ph = 4, XOUT0 and CTRL[0]
#  at the next ph = 1 cycles, lane 0's F/I/D/X and the PIN latency.
#      sby -f -d ref/build/bringup_cover top_bringup.sby cover
#
#  ---- Design under verification: exactly ONE of the two lines below ----
#  The real design (default):
[files]
rosetta_top.sv ../../src/rosetta_top.sv
#  The property writer's private reference model (NOT the design):
#rosetta_top.sv ref/rosetta_top.sv
rosetta_xbar.sv ../../src/rosetta_xbar.sv
rosetta_host.sv ../../src/rosetta_host.sv
rosetta_seq.sv ../../src/rosetta_seq.sv
rosetta_chan.sv ../../src/rosetta_chan.sv
rosetta_mem_prog.sv ../../src/rosetta_mem_prog.sv
rosetta_mem_data.sv ../../src/rosetta_mem_data.sv
rosetta_sram512x32.sv ../../src/rosetta_sram512x32.sv
rosetta_lane.sv ../../src/rosetta_lane.sv
rosetta_cfg.sv ../../src/rosetta_cfg.sv
rosetta_tick.sv ../../src/rosetta_tick.sv
rosetta_delay.sv ../../src/rosetta_delay.sv
rosetta_coding.sv ../../src/rosetta_coding.sv
rosetta_field.sv ../../src/rosetta_field.sv
rosetta_crc.sv ../../src/rosetta_crc.sv
rosetta_stuff.sv ../../src/rosetta_stuff.sv
rosetta_events.sv ../../src/rosetta_events.sv
rosetta_pins.sv ../../src/rosetta_pins.sv
macro_full.sv
shells.sv
top_wb.svh
top_wb.ys
top_wb_mac.ys
top_props.sv
top_fv.sv

# ----------------------------------------------------------------------------
#  cover  depth 310, covers checked from step 280 on (skip 280: every cover
#         here is sticky, so nothing reachable earlier is lost, and the
#         solver is not asked the costly unreachable questions at every
#         earlier step). Script: reset released at step 2, frames start 4
#         cycles later, 3 frames x 96 = 288, CTRL[0] served <= 5 cycles after
#         its 40th edge, lane 0's first D/X cycles, then the lane's PIN
#         latency (top.md 6: t+3 onward): the bring-up lands near step 300.
# ----------------------------------------------------------------------------
[tasks]
cover
core

[options]
cover: mode cover
cover: depth 310
cover: skip 280
core: mode cover
core: depth 40

[engines]
cover: smtbmc bitwuzla
core: smtbmc bitwuzla

[script]
cover: read -define TOP_CHK_CHIP TOP_SPI_SCRIPT TOP_REAL_ROSETTA_HOST
core: read -define TOP_CHK_CORE
read -define TOP_REAL_ROSETTA_XBAR TOP_REAL_ROSETTA_SEQ TOP_REAL_ROSETTA_CHAN TOP_REAL_ROSETTA_MEM_PROG TOP_REAL_ROSETTA_MEM_DATA TOP_REAL_ROSETTA_LANE
read -formal macro_full.sv
read -formal rosetta_sram512x32.sv
cover: read -formal rosetta_host.sv
read -formal rosetta_xbar.sv rosetta_seq.sv rosetta_chan.sv rosetta_mem_prog.sv rosetta_mem_data.sv
read -formal rosetta_cfg.sv rosetta_tick.sv rosetta_delay.sv rosetta_coding.sv rosetta_field.sv rosetta_crc.sv rosetta_stuff.sv rosetta_events.sv rosetta_pins.sv rosetta_lane.sv
read -formal shells.sv
read -formal rosetta_top.sv
read -formal top_props.sv
read -formal top_fv.sv
prep -top top_fv
flatten
script top_wb.ys
script top_wb_mac.ys
opt_clean
