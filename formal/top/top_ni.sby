# ============================================================================
#  SymbiYosys job NI for the chip top: T8 non-interference (top.md 5, the
#  exact statement there), core level, two copies, one task per lane L.
#      sby -f -d ref/build/ni_prove_l0 top_ni.sby prove_l0
#
#  Design (each copy): real u_xbar, u_seq, u_chan, u_mem_prog, u_mem_data;
#  u_host is a SHELL (core level: the host request interface is free,
#  constrained by the slot rule = host.md property 1 and by T8 assumption 4);
#  all four lanes are SHELLS (T8 assumption 8 for the other three; lane L
#  under the relational lane lemma, lane.md 9 property 3, T8 assumption 7);
#  the SRAM macros are driven by the paired tracked-word models of
#  top_ni_props (T8 assumption 5). See top_props.sv, top_ni_props.
#
#  ---- Design under verification: exactly ONE of the two lines below ----
#  The real design (default):
[files]
rosetta_top.sv ../../src/rosetta_top.sv
#  The property writer's private reference model (NOT the design):
#rosetta_top.sv ref/rosetta_top.sv
rosetta_xbar.sv ../../src/rosetta_xbar.sv
rosetta_seq.sv ../../src/rosetta_seq.sv
rosetta_chan.sv ../../src/rosetta_chan.sv
rosetta_mem_prog.sv ../../src/rosetta_mem_prog.sv
rosetta_mem_data.sv ../../src/rosetta_mem_data.sv
rosetta_sram512x32.sv ../../src/rosetta_sram512x32.sv
shell_macro_ext.sv
shells.sv
top_wb.svh
top_wb_ab.ys
top_wb_mac_ab.ys
top_ni_mac.ys
top_props.sv
top_fv.sv

# ----------------------------------------------------------------------------
#  prove_lL  k-induction (smtbmc bitwuzla), depth 12. The relational
#            invariant is asserted on observable state (lane L's sequencer
#            obs ports, run, attn, qwait, queue pointers, wheel, time, the
#            tracked words, lane L's inputs); the only design state not
#            visible at a port is the sequencer's IR and D/X register and the
#            crossbar's two synchroniser stages, all functions of at most
#            the last 5 cycles (one wheel turn): depth >= 6 lets induction
#            see one full slot of lane L; 12 = two turns plus margin.
#  bmc_lL    depth 14, supplementary (two wheel turns beyond the prove basecase
#            of 12; deeper unrollings of the two copies are slow with
#            bitwuzla and add nothing the induction does not prove).
#  cover_lL  depth 20: every assumption's cover (host writes at ph = 1 and
#            ph = 4 need no SPI at core level).
# ----------------------------------------------------------------------------
[tasks]
prove_l0 prove L0
prove_l1 prove L1
prove_l2 prove L2
prove_l3 prove L3
bmc_l0 bmc L0
bmc_l1 bmc L1
bmc_l2 bmc L2
bmc_l3 bmc L3
cover_l0 cover L0
cover_l1 cover L1
cover_l2 cover L2
cover_l3 cover L3

[options]
prove: mode prove
prove: depth 12
bmc: mode bmc
bmc: depth 14
cover: mode cover
cover: depth 20

[engines]
prove: smtbmc bitwuzla
bmc: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
L0: read -define NI_L=0
L1: read -define NI_L=1
L2: read -define NI_L=2
L3: read -define NI_L=3
read -define TOP_REAL_ROSETTA_XBAR TOP_REAL_ROSETTA_SEQ TOP_REAL_ROSETTA_CHAN TOP_REAL_ROSETTA_MEM_PROG TOP_REAL_ROSETTA_MEM_DATA
read -formal shell_macro_ext.sv
read -formal rosetta_sram512x32.sv
read -formal rosetta_xbar.sv rosetta_seq.sv rosetta_chan.sv rosetta_mem_prog.sv rosetta_mem_data.sv
read -formal shells.sv
read -formal rosetta_top.sv
read -formal top_props.sv
read -formal top_fv.sv
prep -top top_ni_fv
flatten
script top_wb_ab.ys
script top_wb_mac_ab.ys
script top_ni_mac.ys
opt_clean
